# musicxx 外部插件 SDK 的 find_package 配置（由 src/host/CMakeLists.txt 安装到
# `<前缀>/lib/cmake/musicxx_extern_plugin/`）
#
# 用法（插件作者）：
# ```cmake
# cmake_minimum_required(VERSION 3.20)
# project(my_plugin LANGUAGES CXX)
#
# # 指定 SDK 前缀（或设 CMAKE_PREFIX_PATH=<前缀>）
# set(musicxx_extern_plugin_DIR "<前缀>/lib/cmake/musicxx_extern_plugin")
# find_package(musicxx_extern_plugin CONFIG REQUIRED)
#
# musicxx_plugin_add_target(my_plugin SOURCES my_plugin.cpp MANIFEST plugin.yaml)
# ```
#
# 本文件提供：
# - `musicxx_extern_plugin_sdk`：INTERFACE 目标（包含目录 + 平台宏 + C++26），插件的唯一编译依赖；
# - `MUSICXX_EXTERN_PLUGIN_SDK_INCLUDE_DIRS` / `MUSICXX_EXTERN_PLUGIN_CMAKE_DIR`：给手工配置用；
# - `musicxx_plugin_add_target(...)`：构建助手（本文件末尾 include 进来）；
# - 顺带解析同前缀里的依赖包（cxx_pluginxx / cxx_utilxx_base / fmt / Boost），
#   这样插件作者只要一个 `find_package` 就能拿到 `cxx_pluginxx_static` 等目标。
#
# 注意：SDK 头文件依赖内核（`pluginxx/*`）与 `utilxx_base`/Boost 头文件，这些头文件都随
# 同一个前缀安装（`<前缀>/include`）；Boost 头文件位置是配置时记录的绝对路径。

# 同前缀里的依赖包：先把前缀自身加进搜索路径（调用方只设了 musicxx_extern_plugin_DIR 时也能命中）
get_filename_component(_musicxx_extern_plugin_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
list(APPEND CMAKE_PREFIX_PATH "${_musicxx_extern_plugin_prefix}")

include(CMakeFindDependencyMacro)
# 都是"找到就链接"的可选依赖：缺了不影响插件编译，只是插件自己不能用对应库
find_dependency(cxx_pluginxx CONFIG QUIET)
find_dependency(cxx_utilxx_base CONFIG QUIET)
find_dependency(fmt CONFIG QUIET)
find_dependency(Boost CONFIG QUIET)

set(MUSICXX_EXTERN_PLUGIN_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(MUSICXX_EXTERN_PLUGIN_SDK_INCLUDE_DIRS
    "@MUSICXX_EXTERN_PLUGIN_SDK_INCLUDE_DIRS@"
    CACHE STRING "插件 SDK 的包含目录")

if (NOT TARGET musicxx_extern_plugin_sdk)
  add_library(musicxx_extern_plugin_sdk INTERFACE IMPORTED)
  # 说明：这里**不用** INTERFACE_COMPILE_FEATURES（`cxx_std_26` 在本机 CMake + MSVC 的特性表里还没有，
  # 会报 "The compiler feature cxx_std_26 is not known to CXX compiler MSVC"）；
  # 语言标准由 `musicxx_plugin_add_target` 通过 CXX_STANDARD 属性设置（与宿主工程内部一致）。
  set_target_properties(musicxx_extern_plugin_sdk PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${MUSICXX_EXTERN_PLUGIN_SDK_INCLUDE_DIRS}"
    INTERFACE_COMPILE_DEFINITIONS "BOOST_ASIO_STANDALONE=1;ASIO_STANDALONE=1;UTILXX_USE_BOOST_ASIO=1")
  if (MSVC)
    set_property(TARGET musicxx_extern_plugin_sdk APPEND PROPERTY INTERFACE_COMPILE_OPTIONS /utf-8)
  endif ()
endif ()

set(musicxx_extern_plugin_FOUND TRUE)

# 构建助手（`musicxx_plugin_add_target`）：随本配置文件一起安装
include("${CMAKE_CURRENT_LIST_DIR}/musicxx_plugin.cmake")
