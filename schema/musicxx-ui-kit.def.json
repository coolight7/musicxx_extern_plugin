{
  "schemaVersion": 1,
  "kitVersion": 1,
  "doc": "musicxx 扩展 kit：应用自己的留白规则 + 设置行/封面行/着色器块等本客户端常用组合（只装配，不含逻辑）",
  "components": [
    {
      "name": "title",
      "doc": "标题行（覆盖基础 kit：自带上下留白，框架不再给隐含边距）",
      "params": [{ "name": "text", "type": "text", "required": true }],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "vertical": 15 },
            "children": [{ "kind": "Text", "text": "$text", "type": "title" }]
          }
        }
      ]
    },
    {
      "name": "hint",
      "doc": "次要说明行（覆盖基础 kit：自带上下留白，框架不再给隐含边距）",
      "params": [{ "name": "text", "type": "text", "required": true }],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "vertical": 15 },
            "children": [
              { "kind": "Text", "text": "$text", "type": "caption", "tone": "hint" }
            ]
          }
        }
      ]
    },
    {
      "name": "text",
      "doc": "正文行（覆盖基础 kit：自带上下留白，框架不再给隐含边距）",
      "params": [
        { "name": "text", "type": "text", "required": true },
        { "name": "tone", "type": "tone", "default": "normal" },
        { "name": "mono", "type": "bool", "default": false }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "vertical": 15 },
            "children": [
              { "kind": "Text", "text": "$text", "tone": "$tone", "mono": "$mono" }
            ]
          }
        }
      ]
    },
    {
      "name": "divider",
      "doc": "分隔线（覆盖基础 kit：自带上下留白）",
      "params": [],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "vertical": 15 },
            "children": [{ "kind": "Divider" }]
          }
        }
      ]
    },
    {
      "name": "button",
      "doc": "按钮（覆盖基础 kit：自带上下留白）",
      "params": [
        { "name": "label", "type": "text", "required": true },
        { "name": "variant", "type": "enum:buttonVariant", "default": "secondary" },
        { "name": "icon", "type": "string" },
        { "name": "disabled", "type": "bool", "default": false },
        { "name": "action", "type": "action" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "vertical": 15 },
            "children": [
              {
                "kind": "Button",
                "label": "$label",
                "variant": "$variant",
                "icon": "$icon",
                "disabled": "$disabled",
                "action": "$action"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "card",
      "doc": "内容块（卡片，覆盖基础 kit：留白在这里声明，框架不再给隐含边距）",
      "params": [
        { "name": "title", "type": "text" },
        { "name": "variant", "type": "enum:blockVariant", "default": "card" },
        {
          "name": "padding",
          "type": "edges",
          "default": { "horizontal": 50, "vertical": 50 }
        },
        { "name": "margin", "type": "edges", "default": { "vertical": 50 } },
        { "name": "children", "type": "items" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "title": "$title",
            "variant": "$variant",
            "padding": "$padding",
            "margin": "$margin",
            "children": "$children"
          }
        }
      ]
    },
    {
      "name": "listRow",
      "doc": "卡片里的一行（不带底色：卡片里直接按列表排列；右侧状态用说明字号）",
      "params": [
        { "name": "title", "type": "text", "required": true },
        { "name": "subtitle", "type": "text" },
        { "name": "trailing", "type": "text" },
        { "name": "action", "type": "action" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "horizontal": 10, "vertical": 6 },
            "action": "$action",
            "children": [
              {
                "kind": "Row",
                "gap": 10,
                "cross": "center",
                "children": [
                  {
                    "kind": "Expanded",
                    "children": [
                      {
                        "kind": "Column",
                        "gap": 2,
                        "children": [
                          { "kind": "Text", "text": "$title" },
                          { "$require": "subtitle", "kind": "Text", "text": "$subtitle", "type": "caption", "tone": "hint" }
                        ]
                      }
                    ]
                  },
                  { "$require": "trailing", "kind": "Text", "text": "$trailing", "type": "caption", "tone": "hint" }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "settingRow",
      "doc": "设置行：标题 + 说明 + 右侧当前值（整行可点且不带底色，右侧值用说明字号）",
      "params": [
        { "name": "title", "type": "text", "required": true },
        { "name": "depict", "type": "text" },
        { "name": "value", "type": "text" },
        { "name": "action", "type": "action" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "horizontal": 10, "vertical": 6 },
            "action": "$action",
            "children": [
              {
                "kind": "Row",
                "gap": 12,
                "cross": "center",
                "children": [
                  {
                    "kind": "Expanded",
                    "children": [
                      {
                        "kind": "Column",
                        "gap": 2,
                        "children": [
                          { "kind": "Text", "text": "$title" },
                          { "$require": "depict", "kind": "Text", "text": "$depict", "type": "caption", "tone": "hint" }
                        ]
                      }
                    ]
                  },
                  { "$require": "value", "kind": "Text", "text": "$value", "type": "caption", "tone": "hint" }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "switchRow",
      "doc": "开关行：标题 + 说明 + 右侧开关（不带底色，值变化即派发动作、参数带 id 与当前值）",
      "params": [
        { "name": "id", "type": "string", "required": true },
        { "name": "title", "type": "text", "required": true },
        { "name": "depict", "type": "text" },
        { "name": "value", "type": "json" },
        { "name": "action", "type": "action" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "horizontal": 10, "vertical": 6 },
            "children": [
              {
                "kind": "Row",
                "gap": 12,
                "cross": "center",
                "children": [
                  {
                    "kind": "Expanded",
                    "children": [
                      {
                        "kind": "Column",
                        "gap": 2,
                        "children": [
                          { "kind": "Text", "text": "$title" },
                          { "$require": "depict", "kind": "Text", "text": "$depict", "type": "caption", "tone": "hint" }
                        ]
                      }
                    ]
                  },
                  {
                    "kind": "Control",
                    "control": "switch",
                    "id": "$id",
                    "value": "$value",
                    "action": "$action"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "inputRow",
      "doc": "输入行：标题 + 说明 + 输入框（不带底色，输入完成即派发动作）",
      "params": [
        { "name": "id", "type": "string", "required": true },
        { "name": "title", "type": "text", "required": true },
        { "name": "depict", "type": "text" },
        { "name": "value", "type": "json" },
        { "name": "multiline", "type": "bool", "default": false },
        { "name": "action", "type": "action" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "horizontal": 10, "vertical": 6 },
            "children": [
              {
                "kind": "Column",
                "gap": 6,
                "children": [
                  { "kind": "Text", "text": "$title" },
                  { "$require": "depict", "kind": "Text", "text": "$depict", "type": "caption", "tone": "hint" },
                  {
                    "kind": "Control",
                    "control": "text",
                    "id": "$id",
                    "value": "$value",
                    "multiline": "$multiline",
                    "action": "$action"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "shaderBlock",
      "doc": "插件着色器块（musicxx 专属组件；终端之类不认识它的客户端会跳过）",
      "params": [
        { "name": "bundle", "type": "string", "required": true },
        { "name": "args", "type": "json" },
        { "name": "speed", "type": "float", "default": 1 },
        { "name": "maxFps", "type": "int" },
        { "name": "animate", "type": "bool", "default": true },
        { "name": "resolutionScale", "type": "float", "default": 1 }
      ],
      "variants": [
        {
          "requires": ["musicxx.Shader"],
          "template": {
            "kind": "musicxx.Shader",
            "bundle": "$bundle",
            "args": "$args",
            "speed": "$speed",
            "maxFps": "$maxFps",
            "animate": "$animate",
            "resolutionScale": "$resolutionScale"
          }
        },
        { "template": { "kind": "Text", "text": "（这个客户端不支持插件着色器）", "type": "caption", "tone": "hint" } }
      ]
    },
    {
      "name": "coverRow",
      "doc": "带封面的行：封面 + 标题 + 副标题 + 可选右侧状态（不带底色；取不到图片时显示标题）",
      "params": [
        { "name": "cover", "type": "string", "required": true },
        { "name": "title", "type": "text", "required": true },
        { "name": "subtitle", "type": "text" },
        { "name": "trailing", "type": "text" },
        { "name": "size", "type": "size", "default": 40 },
        { "name": "action", "type": "action" }
      ],
      "variants": [
        {
          "requires": ["Image"],
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "horizontal": 10, "vertical": 6 },
            "action": "$action",
            "children": [
              {
                "kind": "Row",
                "gap": 10,
                "cross": "center",
                "children": [
                  { "kind": "Image", "source": "file", "src": "$cover", "width": "$size", "height": "$size", "radius": 4, "alt": "$title" },
                  {
                    "kind": "Expanded",
                    "children": [
                      {
                        "kind": "Column",
                        "gap": 2,
                        "children": [
                          { "kind": "Text", "text": "$title" },
                          { "$require": "subtitle", "kind": "Text", "text": "$subtitle", "type": "caption", "tone": "hint" }
                        ]
                      }
                    ]
                  },
                  { "$require": "trailing", "kind": "Text", "text": "$trailing", "type": "caption", "tone": "hint" }
                ]
              }
            ]
          }
        },
        {
          "template": {
            "kind": "Block",
            "variant": "plain",
            "padding": { "horizontal": 10, "vertical": 6 },
            "action": "$action",
            "children": [
              {
                "kind": "Row",
                "gap": 10,
                "cross": "center",
                "children": [
                  {
                    "kind": "Expanded",
                    "children": [
                      {
                        "kind": "Column",
                        "gap": 2,
                        "children": [
                          { "kind": "Text", "text": "$title" },
                          { "$require": "subtitle", "kind": "Text", "text": "$subtitle", "type": "caption", "tone": "hint" }
                        ]
                      }
                    ]
                  },
                  { "$require": "trailing", "kind": "Text", "text": "$trailing", "type": "caption", "tone": "hint" }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "progressRow",
      "doc": "一行进度（覆盖基础 kit：musicxx 默认按百分比显示数值）",
      "params": [
        { "name": "label", "type": "text" },
        { "name": "value", "type": "float", "required": true },
        { "name": "total", "type": "float", "default": 100 },
        { "name": "unit", "type": "string", "default": "%" }
      ],
      "variants": [
        {
          "template": {
            "kind": "Row",
            "gap": 12,
            "cross": "center",
            "children": [
              { "$require": "label", "kind": "Text", "text": "$label" },
              {
                "kind": "Expanded",
                "children": [
                  { "kind": "Progress", "value": "$value", "total": "$total", "unit": "$unit" }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "name": "animScope",
      "doc": "动画作用域：声明通道表（名字 → 值表达式）并逐帧驱动子树（musicxx.AnimatedBuilder）",
      "params": [
        { "name": "values", "type": "json", "required": true },
        { "name": "maxFps", "type": "int" },
        { "name": "children", "type": "items", "required": true }
      ],
      "variants": [
        {
          "template": {
            "kind": "musicxx.AnimatedBuilder",
            "values": "$values",
            "children": "$children"
          }
        },
        {
          "template": {
            "kind": "musicxx.AnimatedBuilder",
            "values": "$values",
            "$require": "maxFps",
            "maxFps": "$maxFps",
            "children": "$children"
          }
        }
      ]
    },
    {
      "name": "fadeTransition",
      "doc": "透明度过渡：按 value（0~1，字面量或值表达式）淡入淡出；curve 是简写缓动",
      "params": [
        { "name": "value", "type": "value", "required": true },
        { "name": "curve", "type": "enum:ease" },
        { "name": "children", "type": "items", "required": true }
      ],
      "variants": [
        {
          "template": {
            "kind": "musicxx.FadeTransition",
            "value": "$value",
            "children": "$children"
          }
        },
        {
          "template": {
            "kind": "musicxx.FadeTransition",
            "value": "$value",
            "$require": "curve",
            "curve": "$curve",
            "children": "$children"
          }
        }
      ]
    },
    {
      "name": "sizeTransition",
      "doc": "尺寸过渡：按 value（0~1）把子块从 0 撑开 / 收拢（axis 缺省竖直）",
      "params": [
        { "name": "value", "type": "value", "required": true },
        { "name": "axis", "type": "enum:axis" },
        { "name": "curve", "type": "enum:ease" },
        { "name": "children", "type": "items", "required": true }
      ],
      "variants": [
        {
          "template": {
            "kind": "musicxx.SizeTransition",
            "value": "$value",
            "children": "$children"
          }
        },
        {
          "template": {
            "kind": "musicxx.SizeTransition",
            "value": "$value",
            "$require": "curve",
            "curve": "$curve",
            "children": "$children"
          }
        },
        {
          "template": {
            "kind": "musicxx.SizeTransition",
            "value": "$value",
            "$require": "axis",
            "axis": "$axis",
            "$require": "curve",
            "curve": "$curve",
            "children": "$children"
          }
        }
      ]
    },
    {
      "name": "scaleTransition",
      "doc": "缩放过渡：按 value（0~1）从 from 缩放到 to（缺省 0 → 1）",
      "params": [
        { "name": "value", "type": "value", "required": true },
        { "name": "from", "type": "value" },
        { "name": "to", "type": "value" },
        { "name": "curve", "type": "enum:ease" },
        { "name": "children", "type": "items", "required": true }
      ],
      "variants": [
        {
          "template": {
            "kind": "musicxx.ScaleTransition",
            "value": "$value",
            "children": "$children"
          }
        },
        {
          "template": {
            "kind": "musicxx.ScaleTransition",
            "value": "$value",
            "$require": "curve",
            "curve": "$curve",
            "children": "$children"
          }
        },
        {
          "template": {
            "kind": "musicxx.ScaleTransition",
            "value": "$value",
            "$require": "from",
            "from": "$from",
            "$require": "to",
            "to": "$to",
            "$require": "curve",
            "curve": "$curve",
            "children": "$children"
          }
        }
      ]
    },
    {
      "name": "rotationTransition",
      "doc": "旋转过渡：按 value（0~1）从 from 转到 to（单位 = 圈数，缺省 0 → 1）",
      "params": [
        { "name": "value", "type": "value", "required": true },
        { "name": "from", "type": "value" },
        { "name": "to", "type": "value" },
        { "name": "curve", "type": "enum:ease" },
        { "name": "children", "type": "items", "required": true }
      ],
      "variants": [
        {
          "template": {
            "kind": "musicxx.RotationTransition",
            "value": "$value",
            "children": "$children"
          }
        },
        {
          "template": {
            "kind": "musicxx.RotationTransition",
            "value": "$value",
            "$require": "from",
            "from": "$from",
            "$require": "to",
            "to": "$to",
            "$require": "curve",
            "curve": "$curve",
            "children": "$children"
          }
        }
      ]
    },
    {
      "name": "slideTransition",
      "doc": "位移过渡：按 value（0~1）从 from 移到 to（单位 = 自身尺寸的倍数，如 [0, 0.1] → [0, 0]）",
      "params": [
        { "name": "value", "type": "value", "required": true },
        { "name": "from", "type": "value" },
        { "name": "to", "type": "value" },
        { "name": "curve", "type": "enum:ease" },
        { "name": "children", "type": "items", "required": true }
      ],
      "variants": [
        {
          "template": {
            "kind": "musicxx.SlideTransition",
            "value": "$value",
            "children": "$children"
          }
        },
        {
          "template": {
            "kind": "musicxx.SlideTransition",
            "value": "$value",
            "$require": "from",
            "from": "$from",
            "$require": "to",
            "to": "$to",
            "$require": "curve",
            "curve": "$curve",
            "children": "$children"
          }
        }
      ]
    }
  ]
}