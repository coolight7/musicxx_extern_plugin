    { "id": "musicxx.media.wave.ready", "dart": "mediaWaveReady", "mode": "observe", "policy": "lastWrite", "dispatch": "async", "budgetMs": 0, "hardMs": 0, "phase": "P1", "doc": "" },
    { "id": "musicxx.media.chorus.analysed", "dart": "mediaChorusAnalysed", "mode": "observe", "policy": "lastWrite", "dispatch": "async", "budgetMs": 0, "hardMs": 0, "phase": "P1", "doc": "" },
